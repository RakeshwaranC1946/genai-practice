    "correct_pin = 1902\n",
    "attempts = 0\n",
    "\n",
    "while attempts <3:\n",
    "    pin=int(input(\"Enter your pin :\"))\n",
    "\n",
    "    if pin == correct_pin:\n",
    "        print(\"Opened..\")\n",
    "        break\n",
    "    else:\n",
    "        attempts +=1\n",
    "        print(\"Invalid Pin..\")\n",
